<?xml version="1.0" encoding="utf-8"?>
<package xmlns="http://schemas.microsoft.com/packaging/2015/06/nuspec.xsd">
  <metadata>
    <id>corneta</id>
    <version>0.13.1</version>
    <title>Corneta</title>
    <authors>Petro Cardoso (pitroldev)</authors>
    <owners>pitroldev</owners>
    <projectUrl>https://www.corneta.live/en</projectUrl>
    <iconUrl>https://cdn.jsdelivr.net/gh/pitroldev/corneta@45a5d3fb7422af0c106f65c408f6888145cec432/src-tauri/icons/128x128.png</iconUrl>
    <copyright>Copyright (c) 2026 Petro Cardoso (Pitrol)</copyright>
    <licenseUrl>https://github.com/pitroldev/corneta/blob/v0.13.1/LICENSE</licenseUrl>
    <requireLicenseAcceptance>false</requireLicenseAcceptance>
    <projectSourceUrl>https://github.com/pitroldev/corneta</projectSourceUrl>
    <packageSourceUrl>https://github.com/pitroldev/chocolatey-corneta</packageSourceUrl>
    <bugTrackerUrl>https://github.com/pitroldev/corneta/issues</bugTrackerUrl>
    <tags>corneta streaming multistream obs twitch youtube video open-source</tags>
    <summary>Free local multistreaming for Windows with unified chat and stream replays.</summary>
    <description><![CDATA[Corneta is a free, open-source Windows desktop companion for OBS and other RTMP encoders. Send a local stream to Twitch, YouTube, Kick, and custom RTMP/RTMPS destinations, follow supported platform chats, adjust quality per destination, and optionally record with synchronized chat replay.

No Corneta account or subscription is required. Your computer processes and uploads the stream; bandwidth and hardware requirements depend on the selected mode and destinations.

Requires Windows 10/11 x64 and Microsoft Edge WebView2 Runtime. This package uses the official per-user NSIS installer, normally under %LOCALAPPDATA%\Corneta for the account running Chocolatey. Run installation and removal as that same Windows account. Close Corneta before installing, upgrading, or uninstalling. User data is not explicitly deleted by this package.

Corneta is MIT licensed. Bundled FFmpeg and MediaMTX retain their own licenses and notices.]]></description>
    <releaseNotes>https://github.com/pitroldev/corneta/releases/tag/v0.13.1</releaseNotes>
    <dependencies>
      <dependency id="chocolatey" version="[2.0.0,)" />
      <dependency id="webview2-runtime" />
    </dependencies>
  </metadata>
  <files>
    <file src="tools\**" target="tools" />
  </files>
</package>
